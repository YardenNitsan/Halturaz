# The build's Supabase settings, on purpose in the repo.
#
# Both values are client-side by design: Vite bakes them into the JS every
# visitor downloads, so a published site hands them out anyway. Keeping them
# here means a build needs nothing configured — no CI secrets, no dashboard —
# and `npm run build` produces the same site wherever it runs.
#
# The secret key and the database URL are a different matter entirely; those
# live in .env.admin, which is gitignored and never read by Vite.
VITE_SUPABASE_URL=https://fvalohnlozipuwicoplw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mxxW6fPo48NYAZedoonAtA_gU2O183i
