# Copy to .env.admin and fill in. Never committed, never read by Vite,
# never given a VITE_ prefix — these credentials must not reach the browser.
# Used only by app/db/*.mjs for schema and seed work.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# Deploys the chart importer to Edge Functions (`npm run fn:deploy`).
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
